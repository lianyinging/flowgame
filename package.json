{
  "name": "flowgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter flowgame-editor dev",
    "dev:playground": "pnpm --filter playground-vue dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @flowgame/core build",
    "build:vue": "pnpm --filter @flowgame/vue build",
    "build:editor": "pnpm --filter flowgame-editor build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18"
  }
}
