{
  "name": "@flowgame/core",
  "version": "0.1.0",
  "description": "FlowGame workflow editor core (framework-agnostic)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
