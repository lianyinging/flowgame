    "@xyflow/svelte": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tinyflow-ai/ui": "^1.3.4",
    "typescript": "~5.4.5",
    "vite": "^4.4.9",
    "vite-plugin-dts": "^4.5.4"
  }
