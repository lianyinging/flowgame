{
  "name": "@flowgame/vue",
  "version": "0.1.0",
  "description": "FlowGame workflow editor Vue 3 components",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/flowgame.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "flowgame",
    "workflow",
    "vue",
    "vue3",
    "tinyflow"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --skipLibCheck",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@flowgame/core": "^0.1.0",
    "@arco-design/web-vue": "^2.56.0",
    "@tinyflow-ai/ui": "^1.3.4",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "2.56.0",
    "@flowgame/core": "workspace:*",
    "@tinyflow-ai/ui": "^1.3.4",
    "@vitejs/plugin-vue": "^4.3.4",
    "sass": "^1.66.1",
    "typescript": "~5.4.5",
    "vite": "^4.4.9",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.3.4",
    "vue-tsc": "^2.1.6"
  }
}
