# 前端开发环境（Vite 会将 /api 代理到后端 FLOWGAME_PORT）
# 当前 vite.config.ts：前端 8009 -> 后端 8007
# 与 flowgame_python/.env 中 FLOWGAME_REDIS_KEY_PREFIX 保持一致；编辑器保存与 /talk 加载共用此前缀
VITE_FLOWGAME_REDIS_KEY_PREFIX=flow_game:
# 与 flowgame_python/.env 中 FLOWGAME_QDRANT_KB_PREFIX 保持一致；知识库上传/检索请求头 X-Flowgame-Qdrant-Kb-Prefix
VITE_FLOWGAME_QDRANT_KB_PREFIX=flowgame_
