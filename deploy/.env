# 复制为 deploy/.env 后按需修改
# cp .env.example .env

# 宿主机映射端口
FLOWGAME_WEB_PORT=8009
FLOWGAME_API_PORT=8008
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333

# Redis 密码（api 与 redis 容器共用，必填）
REDIS_PASSWORD=请设置强密码

# Docker 镜像（默认 DaoCloud，绕过 docker.1panel.live 超时；海外可改回官方名）
# PYTHON_IMAGE=python:3.10-slim
# NODE_IMAGE=node:20-alpine
# NGINX_IMAGE=nginx:1.27-alpine
# REDIS_IMAGE=redis:7-alpine
# QDRANT_IMAGE=qdrant/qdrant:v1.18.2
# NPM_REGISTRY=https://registry.npmjs.org
# PIP_INDEX_URL=

# 后端工作流执行日志（api 容器）
FLOWGAME_EXECUTION_LOG_ENABLED=true
FLOWGAME_EXECUTION_LOG_PATH=/var/log/flowgame/execution.log
FLOWGAME_EXECUTION_LOG_HOST_DIR=./logs/api
FLOWGAME_EXECUTION_LOG_CONSOLE=true
FLOWGAME_EXECUTION_LOG_LEVEL=INFO

# LLM（可选）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

REDIS_PORT=6379
REDIS_DB=0

QDRANT_PORT=6333
QDRANT_TIMEOUT=30

EMBEDDING_API_TIMEOUT=30
EMBEDDING_VECTOR_SIZE=512
