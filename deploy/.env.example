# 复制为 deploy/.env 后按需修改
# cp .env.example .env

# 宿主机映射端口
FLOWGAME_WEB_PORT=8009
FLOWGAME_API_PORT=8008

# LLM（可选）— 仅旧版 Tinyflow「大模型」节点 llmNode 使用服务端环境变量
# 当前编辑器主推「模型调用」llmapiNode：apiKey / 接口地址 / 模型名均在流程 JSON 中配置，无需此项
# 若流程里仍含历史 llmNode，或从 Redis 加载的旧流程，再填写下面三项
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Redis / Qdrant 在 compose 内通过服务名访问，一般无需改
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

QDRANT_PORT=6333
QDRANT_TIMEOUT=30

# Embedding：推荐生产环境配置独立 HTTP 服务，避免镜像内下载大模型
# EMBEDDING_API_URL=http://your-embedding-service/embed
EMBEDDING_API_TIMEOUT=30
EMBEDDING_VECTOR_SIZE=512
